TELEGRAM_BOT_TOKEN=
# group (or channel) id, the forum topic id, and the private chat for alerts; override config.yaml when set
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_OWNER_USER_ID=
# from: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# developer.ebay.com, Production keyset of your app
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# optional, paid licence from watchcharts.com/api
WATCHCHARTS_API_KEY=
TZ=Asia/Singapore
# Claude usage tracker (nas-doctor claude-usage service)
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://<LAN_IP>:4318/v1/logs
OTEL_RESOURCE_ATTRIBUTES=bot=watchbot
